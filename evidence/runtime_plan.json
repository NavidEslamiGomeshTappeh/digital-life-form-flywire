{
  "schema_version": 1,
  "product_version": "1.1.0",
  "description": "Canonical evidence-gated execution plan for the unified Version 1 product.",
  "policy": "Tasks refer to stable product capabilities, not milestone-numbered product surfaces.",
  "tasks": {
    "REFERENCE_EVIDENCE": {
      "kind": "PYTHON_VALIDATION",
      "deps": [],
      "payload": {"command": "python -m dlf_flywire validate", "timeout_seconds": 120}
    },
    "PROVENANCE_AUDIT": {
      "kind": "PYTHON_VALIDATION",
      "deps": ["REFERENCE_EVIDENCE"],
      "payload": {"command": "python -m dlf_flywire audit", "timeout_seconds": 120}
    },
    "DISTRIBUTION_SMOKE": {
      "kind": "PYTHON_VALIDATION",
      "deps": ["PROVENANCE_AUDIT"],
      "payload": {"command": "python -m build", "timeout_seconds": 120}
    }
  }
}
